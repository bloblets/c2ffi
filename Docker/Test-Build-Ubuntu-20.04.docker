FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive

# 1️⃣ Install basic tools and musl
RUN apt update -y && \
    apt-get install -y wget software-properties-common python3-pip build-essential musl-tools cmake

# 2️⃣ Add LLVM 18 repository and install packages
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc && \
    add-apt-repository -s -y "deb http://apt.llvm.org/focal/ llvm-toolchain-focal-18 main" && \
    apt update -y && \
    apt-get install -y llvm-18 clang-18 libclang-18-dev libclang-cpp18-dev

# 3️⃣ Upgrade CMake via pip (for newer version)
RUN pip3 install --upgrade cmake

# 4️⃣ Copy source code into container
RUN mkdir -p /c2ffi
COPY . /c2ffi
WORKDIR /c2ffi

# 5️⃣ Build c2ffi statically using musl
RUN mkdir -p build && cd build && \
    CC=musl-gcc CXX=musl-g++ cmake -DBUILD_CONFIG=Release -DCMAKE_EXE_LINKER_FLAGS="-static" .. && \
    make

# 6️⃣ Sanity check static binary
RUN ./build/bin/c2ffi --help
